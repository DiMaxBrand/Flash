    <!-- Feature flags (experiments, off by default) -->
    <string name="feature_flags_title">Feature flags</string>
    <string name="feature_flags_disclaimer">Early features, off by default. They may look rough and can change or disappear.</string>
    <string name="feature_flag_option_default">Default</string>
    <string name="feature_flag_option_on">On</string>
